# Local synthetic data is only available on the loopback development server.
ROLECLUE_LOCAL_DEMO=1
PORT=3003
# Production is configured by infrastructure and controlled SSM parameters.
# Do not save real credentials in this file or a checked-in environment file.
# Release-time public OAuth settings are supplied by the deployment workflow:
# ROLECLUE_GOOGLE_SIGN_IN_ENABLED=false
# ROLECLUE_COGNITO_DOMAIN=https://your-prefix.auth.ap-southeast-2.amazoncognito.com
# ROLECLUE_OAUTH_REDIRECT_URI=https://app.proairesis.digital/
# ROLECLUE_RECOMMENDATIONS_ENABLED=true
# ROLECLUE_GUEST_DISCOVERY_ENABLED=true
# ROLECLUE_COVER_LETTERS_ENABLED=true
# ROLECLUE_BILLING_ENABLED=true
# Keep the Google OAuth client secret in the configured AWS SSM SecureString.
